# ClinicCare-Lite environment variables. Copy to .env and fill in.
# NEVER commit a real .env. The app runs fine with none of these set
# (notifications are written to data/notifications.log instead of emailed).

# Flask session signing key - set a long random value in any real deployment
CLINIC_SECRET_KEY=change-me-to-a-long-random-string

# Session inactivity timeout (minutes)
CLINIC_SESSION_MINUTES=30

# Max upload size in bytes (default 2 MB)
CLINIC_MAX_UPLOAD_BYTES=2097152

# SMTP for real email notifications (optional - leave unset for the demo).
# Use a dedicated test/sandbox mailbox, never a personal account.
CLINIC_SMTP_HOST=
CLINIC_SMTP_PORT=587
CLINIC_SMTP_USER=
CLINIC_SMTP_PASSWORD=
CLINIC_SMTP_FROM=no-reply@cliniccare-lite.local
